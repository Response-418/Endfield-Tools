+    def _key_label(self, s):
+        """给左侧大方框用：返回 (大字按键, 小字动作)。"""
+        if not isinstance(s, dict):
+            return "", ""
+        if self._is_note_only(s):
+            return "注", "注释"
+        if s.get("heavy"):
+            return "重", "重击（自动）"
+        op = int(s.get("op", 1) or 1)
+        is_link = str(s.get("key") or "").upper() == "E"
+        if self.display_mode == "pad":
+            slots = (self.pad or {}).get("slots") or []
+            sym = _pad_label(slots[op - 1]) if 0 < op <= len(slots) else str(op)
+            if is_link:
+                return (_pad_label((self.pad or {}).get("link")) or "连携"), "连携"
+            if s.get("hold"):
+                return sym, "终结技"
+            return sym, "战技"
+        raw_key = str(s.get("key") or "").strip()
+        k_skill = raw_key or (self.keys["skill"][op - 1] if 0 < op <= 4 else str(op))
+        if is_link:
