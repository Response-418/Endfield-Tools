+# ---------- 侧键直发（内置在同一个进程里，不用再开第二个脚本/终端） ----------
+import ctypes as _ct
+from ctypes import wintypes as _wt
+
+_WH_MOUSE_LL = 14
+_WH_KEYBOARD_LL = 13
+_WM_XBUTTONDOWN, _WM_XBUTTONUP = 0x020B, 0x020C
+_WM_KEYDOWN, _WM_KEYUP = 0x0100, 0x0101
+_WM_SYSKEYDOWN, _WM_SYSKEYUP = 0x0104, 0x0105
+_XBUTTON1 = 0x0001   # 下侧键（back）
+_XBUTTON2 = 0x0002   # 上侧键（forward），留着以后想换回去用
+_INPUT_KEYBOARD = 1
+_KEYEVENTF_KEYUP, _KEYEVENTF_SCANCODE = 0x0002, 0x0008
+
+_SIDE_VK = {"1": 0x31, "2": 0x32, "3": 0x33, "4": 0x34, "E": 0x45}
+_SIDE_SC = {0x31: 0x02, 0x32: 0x03, 0x33: 0x04, 0x34: 0x05, 0x45: 0x12}
+_SIDE_CYCLE = (0x31, 0x32, 0x33, 0x34)
+_SIDE_NAME = {0x31: "1", 0x32: "2", 0x33: "3", 0x34: "4", 0x45: "E"}
+
+
+class _KEYBDINPUT(_ct.Structure):
+    _fields_ = [("wVk", _wt.WORD), ("wScan", _wt.WORD), ("dwFlags", _wt.DWORD),
+                ("time", _wt.DWORD), ("dwExtraInfo", _ct.c_void_p)]
+
+
+class _MOUSEINPUT(_ct.Structure):
+    _fields_ = [("dx", _wt.LONG), ("dy", _wt.LONG), ("mouseData", _wt.DWORD),
+                ("dwFlags", _wt.DWORD), ("time", _wt.DWORD),
+                ("dwExtraInfo", _ct.c_void_p)]
+
+
+class _HARDWAREINPUT(_ct.Structure):
+    _fields_ = [("uMsg", _wt.DWORD), ("wParamL", _wt.WORD), ("wParamH", _wt.WORD)]
+
+
+class _INPUTUNION(_ct.Union):
+    _fields_ = [("mi", _MOUSEINPUT), ("ki", _KEYBDINPUT), ("hi", _HARDWAREINPUT)]
+
+
+class _INPUT(_ct.Structure):
+    _fields_ = [("type", _wt.DWORD), ("union", _INPUTUNION)]
+
+
+class _MSLLHOOKSTRUCT(_ct.Structure):
+    _fields_ = [("pt", _wt.POINT), ("mouseData", _wt.DWORD), ("flags", _wt.DWORD),
+                ("time", _wt.DWORD), ("dwExtraInfo", _ct.c_void_p)]
+
+
+class _KBDLLHOOKSTRUCT(_ct.Structure):
+    _fields_ = [("vkCode", _wt.DWORD), ("scanCode", _wt.DWORD),
+                ("flags", _wt.DWORD), ("time", _wt.DWORD),
+                ("dwExtraInfo", _ct.c_void_p)]
+
+
+class _MSG(_ct.Structure):
+    _fields_ = [("hwnd", _wt.HWND), ("message", _wt.UINT), ("wParam", _wt.WPARAM),
+                ("lParam", _wt.LPARAM), ("time", _wt.DWORD), ("pt", _wt.POINT)]
+
+
+_HOOKPROC = _ct.WINFUNCTYPE(_wt.LPARAM, _ct.c_int, _wt.WPARAM, _wt.LPARAM)
+# 用独立 DLL 实例：别改 windll.user32 的全局 argtypes，rawpad 也在用同一个对象
+_user32 = _ct.WinDLL("user32")
+_kernel32 = _ct.WinDLL("kernel32")
+_user32.SetWindowsHookExW.argtypes = [_ct.c_int, _HOOKPROC, _wt.HINSTANCE, _wt.DWORD]
+_user32.SetWindowsHookExW.restype = _ct.c_void_p
+_user32.CallNextHookEx.argtypes = [_ct.c_void_p, _ct.c_int, _wt.WPARAM, _wt.LPARAM]
+_user32.CallNextHookEx.restype = _wt.LPARAM
+_user32.SendInput.argtypes = [_wt.UINT, _ct.POINTER(_INPUT), _ct.c_int]
+_user32.SendInput.restype = _wt.UINT
+_user32.UnhookWindowsHookEx.argtypes = [_ct.c_void_p]
+_user32.GetMessageW.argtypes = [_ct.POINTER(_MSG), _wt.HWND, _wt.UINT, _wt.UINT]
+_user32.GetMessageW.restype = _wt.LPARAM
+_user32.TranslateMessage.argtypes = [_ct.POINTER(_MSG)]
+_user32.DispatchMessageW.argtypes = [_ct.POINTER(_MSG)]
+_user32.PostQuitMessage.argtypes = [_ct.c_int]
+_kernel32.GetModuleHandleW.argtypes = [_wt.LPCWSTR]
+_kernel32.GetModuleHandleW.restype = _wt.HINSTANCE
+
+
+class SideKeyHook:
+    """独立线程装 WH_MOUSE_LL：侧键按下就发轴当前需要的键。
+
+    get_target() 返回运行条当前的 _side_key；轴没跑或该步没有键时返回空串，
+    此时退回原来的 1/2/3/4 循环，保证单独按侧键也还有用。
+    """
+
+    def __init__(self, get_target, watch=_XBUTTON1, swallow=True):
+        self.get_target = get_target
+        self.watch = watch
+        self.swallow = swallow
+        self.active_vk = None
+        self.hook = None
+        self.cb_ref = None
+        self.cycle = 0
+        self.stop_req = False
+
+    def _resolve(self):
+        """当前轴要的键；没有就退回 1/2/3/4 循环。"""
+        try:
+            key = str(self.get_target() or "").strip().upper()
+        except Exception:
+            key = ""
+        vk = _SIDE_VK.get(key)
+        if vk:
+            return vk, "轴"
+        vk = _SIDE_CYCLE[self.cycle % len(_SIDE_CYCLE)]
+        self.cycle += 1
+        return vk, "循环"
+
+    def _send_key(self, vk, down):
+        inp = _INPUT()
+        inp.type = _INPUT_KEYBOARD
+        inp.union.ki.wScan = _SIDE_SC.get(vk, 0)
+        inp.union.ki.dwFlags = ((0 if down else _KEYEVENTF_KEYUP)
+                                | _KEYEVENTF_SCANCODE)
+        _user32.SendInput(1, _ct.byref(inp), _ct.sizeof(_INPUT))
+
+    def _callback(self, nCode, wParam, lParam):
+        try:
+            if nCode >= 0 and wParam in (_WM_XBUTTONDOWN, _WM_XBUTTONUP):
+                info = _ct.cast(lParam, _ct.POINTER(_MSLLHOOKSTRUCT)).contents
+                if ((info.mouseData >> 16) & 0xFFFF) == self.watch:
+                    if wParam == _WM_XBUTTONDOWN:
+                        vk, src = self._resolve()
+                        self.active_vk = vk
+                        self._send_key(vk, True)
+                        log("side down -> %s [%s]" % (_SIDE_NAME.get(vk, "?"), src))
+                    else:
+                        if self.active_vk is not None:
+                            self._send_key(self.active_vk, False)
+                            self.active_vk = None
+                    if self.swallow:
+                        return 1
+        except Exception as e:
+            log("side hook err %s" % e)
+        return _user32.CallNextHookEx(self.hook, nCode, wParam, lParam)
+
+    def run(self):
+        try:
+            self.cb_ref = _HOOKPROC(self._callback)
+            self.hook = _user32.SetWindowsHookExW(
+                _WH_MOUSE_LL, self.cb_ref, _kernel32.GetModuleHandleW(None), 0)
+            if not self.hook:
+                log("side hook failed err=%d" % _ct.get_last_error())
+                return
+            log("side hook ready on XBUTTON1 (overlay key, fallback 1/2/3/4)")
+            msg = _MSG()
+            while not self.stop_req:
+                ret = _user32.GetMessageW(_ct.byref(msg), None, 0, 0)
+                if ret <= 0:
+                    break
+                _user32.TranslateMessage(_ct.byref(msg))
+                _user32.DispatchMessageW(_ct.byref(msg))
+        except Exception as e:
+            log("side hook loop err %s" % e)
+        finally:
+            if self.hook:
+                _user32.UnhookWindowsHookEx(self.hook)
+                self.hook = None
+            if self.active_vk is not None:
+                self._send_key(self.active_vk, False)
+                self.active_vk = None
+            log("side hook stopped")
+
+    def stop(self):
+        self.stop_req = True
+        _user32.PostQuitMessage(0)
+
