+# 小键盘快捷键：低级键盘钩子（WH_KEYBOARD_LL），事件驱动。
+# 之前用 GetAsyncKeyState 轮询，游戏抢前台后轮询线程收不到按键（实测第 2 轮
+# 之后就失灵），改成和侧键一样的钩子，任何窗口前台都能捕获。
+_NUMPAD_RUN = 0x61      # NumLock 开：小键盘 1
+_NUMPAD_STOP = 0x62     # NumLock 开：小键盘 2
+_NUMPAD_END = 0x23      # NumLock 关：小键盘 1 = End
+_NUMPAD_DOWN = 0x28     # NumLock 关：小键盘 2 = ↓
+
+
+class NumpadHook:
+    """小键盘 1 = 开始运行，小键盘 2 = 停止运行。
+
+    全局低级键盘钩子，运行条没起来时也能按 1 启动；NumLock 开/关都识别
+    （关时小键盘 1/2 变成 End/↓，靠扩展键标志区分主键盘与小键盘）。
+    """
+
+    def __init__(self):
+        self.hook = None
+        self.cb_ref = None
+        self.stop_req = False
+
+    @staticmethod
+    def _is_numpad(info, vk):
+        """识别小键盘 1/2；NumLock 关时用非 extended 标志排除主键盘 End/↓。"""
+        if info.vkCode != vk:
+            return False
+        # VK_NUMPAD1/2 只可能来自小键盘；部分键盘/远程桌面会带扩展位，不要卡它。
+        if vk in (_NUMPAD_RUN, _NUMPAD_STOP):
+            return True
+        # NumLock 关：小键盘 1/2 变成 End/↓（扫描码 0x4F/0x50，不带扩展位）；
+        # 主键盘导航区的 End/↓ 带 LLKHF_EXTENDED，必须排除。
+        return not (info.flags & 0x01) and info.scanCode in (0x4F, 0x50)
+
+    def _callback(self, nCode, wParam, lParam):
+        try:
+            if nCode >= 0 and wParam in (_WM_KEYDOWN, _WM_KEYUP,
+                                         _WM_SYSKEYDOWN, _WM_SYSKEYUP):
+                info = _ct.cast(lParam, _ct.POINTER(_KBDLLHOOKSTRUCT)).contents
+                act = None
+                if self._is_numpad(info, _NUMPAD_RUN) or self._is_numpad(info, _NUMPAD_END):
+                    act = "run"
+                elif self._is_numpad(info, _NUMPAD_STOP) or self._is_numpad(info, _NUMPAD_DOWN):
+                    act = "stop"
+                if act and wParam in (_WM_KEYDOWN, _WM_SYSKEYDOWN):
+                    # 钩子只发 down 事件；Up 不处理，天然无重复触发
+                    self._fire(act)
+        except Exception as e:
+            log("numpad hook err %s" % e)
+        return _user32.CallNextHookEx(self.hook, nCode, wParam, lParam)
+
+    def _fire(self, act):
+        if act == "run":
+            with _OVERLAY_LOCK:
+                already = (bool(_overlay and _overlay.running) or _OVERLAY_BUSY[0])
+            if already:
+                log("Num1: already running, ignore")
+                return
+            cfg = load_cfg()
+            if not (cfg.get("steps") or []):
+                log("Num1: empty axis, ignore")
+                return
+            log("Num1 -> start overlay (%d steps)" % len(cfg["steps"]))
+            start_overlay(cfg)
+        else:
+            ov = _overlay
+            if ov is not None and getattr(ov, "running", False):
+                log("Num2 -> stop overlay")
+                ov._stop_req = True
+            else:
+                log("Num2: nothing running")
+
+    def run(self):
+        try:
+            self.cb_ref = _HOOKPROC(self._callback)
+            self.hook = _user32.SetWindowsHookExW(
+                _WH_KEYBOARD_LL, self.cb_ref, _kernel32.GetModuleHandleW(None), 0)
+            if not self.hook:
+                log("numpad hook failed err=%d" % _ct.get_last_error())
+                return
+            log("numpad hotkeys ready (Num1=run, Num2=stop, keyboard hook)")
+            msg = _MSG()
+            while not self.stop_req:
+                ret = _user32.GetMessageW(_ct.byref(msg), None, 0, 0)
+                if ret <= 0:
+                    break
+                _user32.TranslateMessage(_ct.byref(msg))
+                _user32.DispatchMessageW(_ct.byref(msg))
+        except Exception as e:
+            log("numpad hook loop err %s" % e)
+        finally:
+            if self.hook:
+                _user32.UnhookWindowsHookEx(self.hook)
+                self.hook = None
+            log("numpad hook stopped")
+
+    def stop(self):
+        self.stop_req = True
+        _user32.PostQuitMessage(0)
